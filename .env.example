PORT=3000
NODE_ENV=development
JWT_SECRET=change_me_to_a_long_random_secret
DATABASE_URL=
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change_me
SEED_CLIENT_EMAIL=client@example.com
SEED_CLIENT_PASSWORD=change_me
DEFAULT_HOURLY_RATE=25
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password

# Example Supabase DATABASE_URL:
# postgres://<db_user>:***@db.<project>.supabase.co:5432/postgres
# For production/Vercel set NODE_ENV=production so the server enables TLS for Postgres.
