# Backend local example. Copy to backend/.env and replace placeholders.
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-local-secret

# Set DATABASE_URL for Postgres/Supabase. Leave empty for explicit local SQLite fallback.
DATABASE_URL=

# Existing owner bootstrap/reset helper lookup. Changing this does not change an existing user password.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-only-for-first-run-bootstrap
SEED_CLIENT_EMAIL=client@example.com
SEED_CLIENT_PASSWORD=replace-only-for-first-run-bootstrap

DEFAULT_HOURLY_RATE=25

# Optional email settings. If omitted, local dev uses Ethereal preview email.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Example Postgres shapes; do not paste real credentials into Git:
# Local:    postgresql://db_user:db_password@localhost:5432/megaconstruct
# Supabase: postgresql://db_user:db_password@db.project-ref.supabase.co:5432/postgres
